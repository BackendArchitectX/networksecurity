# Serving plane
ADMIN_API_KEY=replace-with-a-local-secret
MODEL_REGISTRY_DIR=model_registry
SCHEMA_PATH=data_schema/schema.yaml
TRAINING_JOB_DB_PATH=runtime/training_jobs.db
MAX_BATCH_SIZE=256
MAX_REQUEST_BYTES=1048576
MAX_INFERENCE_CONCURRENCY=8
INFERENCE_ACQUIRE_TIMEOUT_MS=250
MODEL_REFRESH_INTERVAL_SECONDS=5
MODEL_LOAD_ON_STARTUP=true
LOG_LEVEL=INFO

# Durable training queue / worker
MAX_PENDING_TRAINING_JOBS=32
TRAINING_JOB_LEASE_SECONDS=900
TRAINING_JOB_MAX_ATTEMPTS=3
MONGO_DB_URL=mongodb://localhost:27017
DATA_INGESTION_DATABASE_NAME=networksecurity
DATA_INGESTION_COLLECTION_NAME=network_events
MODEL_MIN_F1=0.80
TRAINING_BUCKET_NAME=
MLFLOW_TRACKING_URI=
MLFLOW_EXPERIMENT_NAME=networksecurity
