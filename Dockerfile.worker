FROM python:3.12-slim-bookworm

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /app

RUN addgroup --system app && adduser --system --ingroup app app

COPY requirements.txt requirements-training.txt ./
RUN python -m pip install --upgrade pip && \
    python -m pip install --no-compile -r requirements-training.txt

COPY worker.py main.py ./
COPY data_schema ./data_schema
COPY networksecurity ./networksecurity

RUN mkdir -p /app/runtime /app/model_registry /app/Artifacts && \
    chown -R app:app /app
USER app

CMD ["python", "worker.py"]
